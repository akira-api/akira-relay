# Akira Relay Environment Variables

# HMAC secret shared with Akira backend for signing /v1/stream tokens
RELAY_SECRET=change-this-to-a-secure-random-secret-at-least-32-chars

# Server listening port
PORT=3000

# Cloudflare Tunnel token for sidecar container
RELAY_TUNNEL_TOKEN=

# Comma-separated list of allowed hostname suffixes or exact hosts for upstream targets
ALLOWLIST_HOSTS=acefile.co,blogger.com,googleusercontent.com,googlevideo.com

# Global maximum concurrent streams (HTTP 503 if exceeded)
MAX_CONCURRENT_STREAMS=150

# Maximum concurrent streams per client IP
PER_IP_CONCURRENT_STREAMS=8

# Per-IP rate limit for resolve cache misses (requests per minute)
RATE_LIMIT_RPM=60

# Per-IP rate limit burst limit
RATE_LIMIT_BURST=30

# In-memory resolve cache TTL in milliseconds (default: 15 minutes)
RESOLVE_CACHE_TTL_MS=900000

# Stream read idle sliding timeout in milliseconds (default: 20s)
IDLE_TIMEOUT_MS=20000

# Target resolve & upstream connection timeout in milliseconds before first byte (default: 10s)
RESOLVE_TIMEOUT_MS=10000

# Optional: require X-Relay-Key header for GET /internal/stats (empty = open)
INTERNAL_RELAY_KEY=
